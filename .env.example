# Server-only Netlify Functions variables. Never put RESEND_API_KEY in frontend code.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Optional: verified Resend sender. Omit to save contacts without welcome receipts.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# Public PostHog project token (not a personal API key).
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com
